# >>> pet + dev shortcuts >>>
# fzf: Ctrl+R history, Ctrl+T files, Alt+C cd
source <(fzf --zsh)

# pet: Ctrl+S opens snippets and puts the chosen command on the prompt
# (so `cd` snippets actually change your shell's directory).
stty -ixon 2>/dev/null
pet-select() {
  local sel
  sel=$(pet search --color --query "$LBUFFER")
  [[ -n "$sel" ]] && BUFFER=$sel && CURSOR=$#BUFFER
  zle redisplay
}
zle -N pet-select
bindkey '^s' pet-select
alias pex='pet exec --color'
alias pnew='pet new'
alias pedit='pet edit'

# Launchers
