alias lzd='lazydocker'
alias v='lvim'
alias dps="docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'"
alias dpsa="docker ps -a --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'"
alias dlogs='docker logs -f --tail 100'
alias ll='eza -l --icons --git'

# j: fuzzy-jump to a project folder (searches 2 levels under your main dirs)
j() {
  local dir
  dir=$(fd --type d --max-depth 2 . ~/Desktop ~/Documents ~/Downloads ~/CLionProjects ~/DataGripProjects ~/.config 2>/dev/null \
    | fzf --height=60% --reverse --prompt='jump> ' --preview 'eza --tree --level=1 --icons {}') && cd "$dir"
}
